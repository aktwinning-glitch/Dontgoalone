{
  "name": "Character",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Character display name"
    },
    "portrait_url": {
      "type": "string",
      "description": "URL to character portrait image"
    },
    "description": {
      "type": "string",
      "description": "Short character bio"
    },
    "strength": {
      "type": "number",
      "default": 5
    },
    "speed": {
      "type": "number",
      "default": 5
    },
    "resilience": {
      "type": "number",
      "default": 5
    },
    "intelligence": {
      "type": "number",
      "default": 5
    },
    "fear": {
      "type": "number",
      "default": 5
    },
    "charm": {
      "type": "number",
      "default": 5
    },
    "influence": {
      "type": "number",
      "default": 5
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}