{
  "name": "Dialogue",
  "type": "object",
  "properties": {
    "story_id": {
      "type": "string",
      "description": "Which story this dialogue belongs to (e.g. the_rental)"
    },
    "character_name": {
      "type": "string",
      "description": "Name of the character speaking"
    },
    "category": {
      "type": "string",
      "enum": [
        "banter",
        "clue",
        "regroup",
        "chase",
        "ending",
        "suspicious",
        "funny",
        "tense",
        "emotional",
        "general"
      ],
      "default": "general",
      "description": "Functional tone/category of this line"
    },
    "line": {
      "type": "string",
      "description": "The dialogue text"
    },
    "trigger_context": {
      "type": "string",
      "description": "When this line fires: low_fear, high_fear, after_death, after_choice_success, after_choice_fail, etc."
    },
    "act": {
      "type": "string",
      "description": "Which act this applies to: act_1, act_2, act_3, act_4, any"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags for filtering"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "story_id",
    "character_name",
    "line"
  ]
}