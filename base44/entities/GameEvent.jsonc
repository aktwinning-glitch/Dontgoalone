{
  "name": "GameEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier. Must be scoped to the story (e.g. the_rental:evt_001 or just evt_001 if story_id is always set)"
    },
    "story_id": {
      "type": "string",
      "description": "Which story this event belongs to. Must match a Story.story_id exactly (e.g. the_rental, low_tide, mardi_gras_curse, the_lab). Never use legacy IDs like story_1.",
      "default": ""
    },
    "text": {
      "type": "string",
      "description": "Event narrative text shown to the player"
    },
    "image_key": {
      "type": "string",
      "description": "Scene asset key for optional image"
    },
    "night": {
      "type": "number",
      "default": 1,
      "description": "Which night this event belongs to"
    },
    "phase_label": {
      "type": "string",
      "description": "Optional per-event phase label override (e.g. 'The Search', 'The Reveal'). If empty, falls back to story phase_definitions."
    },
    "location": {
      "type": "string",
      "description": "Primary location this event takes place in. Used by map system. Valid: living, kitchen, porch, upstairs, basement, woods, outdoor, indoor",
      "enum": [
        "living",
        "kitchen",
        "porch",
        "upstairs",
        "basement",
        "woods",
        "outdoor",
        "indoor",
        ""
      ]
    },
    "group_spread": {
      "type": "string",
      "description": "JSON array describing where each party member is during this event. [{memberId, location}]. Drives map spread visualization."
    },
    "conditions": {
      "type": "string",
      "description": "JSON string of conditions (flags, threat, fear, stats, inventory)"
    },
    "choices": {
      "type": "string",
      "description": "JSON string of choices array"
    },
    "is_ending": {
      "type": "boolean",
      "default": false,
      "description": "Whether this event is a game ending"
    },
    "ending_type": {
      "type": "string",
      "enum": [
        "good",
        "mixed",
        "bad",
        ""
      ],
      "default": ""
    },
    "ending_text": {
      "type": "string",
      "description": "Final text shown if this is an ending event"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "event_id",
    "text"
  ]
}